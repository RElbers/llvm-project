# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50 -run-pass si-insert-waitcnts -o - %s | FileCheck -check-prefix=GFX950 %s

# A software-pipelined loop: the preheader loads the first group, and the loop
# copies the carried value out before it loads the next group into the same
# register. The header reads $vgpr2, loaded outside the loop, before any VMEM
# instruction of its own. Flushing vmcnt in the preheader keeps the preheader's
# pending loads out of the state merged at the header, so the wait before the
# copy only covers the load the back edge needs and leaves the previous
# iteration's two stores outstanding.

---
name:            copy_out_before_reload
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; GFX950-LABEL: name: copy_out_before_reload
  ; GFX950: bb.0:
  ; GFX950-NEXT:   successors: %bb.1(0x80000000)
  ; GFX950-NEXT:   liveins: $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7
  ; GFX950-NEXT: {{  $}}
  ; GFX950-NEXT:   $vgpr1 = BUFFER_LOAD_DWORD_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
  ; GFX950-NEXT:   $vgpr2 = BUFFER_LOAD_DWORD_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, implicit $exec
  ; GFX950-NEXT:   S_WAITCNT .Vmcnt_0
  ; GFX950-NEXT:   S_BRANCH %bb.1
  ; GFX950-NEXT: {{  $}}
  ; GFX950-NEXT: bb.1:
  ; GFX950-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GFX950-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7
  ; GFX950-NEXT: {{  $}}
  ; GFX950-NEXT:   S_WAITCNT .Vmcnt_2
  ; GFX950-NEXT:   $vgpr3 = V_MOV_B32_e32 $vgpr2, implicit $exec
  ; GFX950-NEXT:   $vgpr4 = V_MOV_B32_e32 $vgpr1, implicit $exec
  ; GFX950-NEXT:   $vgpr1 = BUFFER_LOAD_DWORD_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 8, 0, 0, implicit $exec
  ; GFX950-NEXT:   $vgpr2 = BUFFER_LOAD_DWORD_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 12, 0, 0, implicit $exec
  ; GFX950-NEXT:   BUFFER_STORE_DWORD_OFFEN $vgpr3, $vgpr0, $sgpr4_sgpr5_sgpr6_sgpr7, 0, 0, 0, 0, implicit $exec
  ; GFX950-NEXT:   BUFFER_STORE_DWORD_OFFEN $vgpr4, $vgpr0, $sgpr4_sgpr5_sgpr6_sgpr7, 0, 4, 0, 0, implicit $exec
  ; GFX950-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit undef $scc
  ; GFX950-NEXT: {{  $}}
  ; GFX950-NEXT: bb.2:
  ; GFX950-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7

    $vgpr1 = BUFFER_LOAD_DWORD_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec
    $vgpr2 = BUFFER_LOAD_DWORD_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7

    $vgpr3 = V_MOV_B32_e32 $vgpr2, implicit $exec
    $vgpr4 = V_MOV_B32_e32 $vgpr1, implicit $exec
    $vgpr1 = BUFFER_LOAD_DWORD_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 8, 0, 0, implicit $exec
    $vgpr2 = BUFFER_LOAD_DWORD_OFFEN $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 12, 0, 0, implicit $exec
    BUFFER_STORE_DWORD_OFFEN $vgpr3, $vgpr0, $sgpr4_sgpr5_sgpr6_sgpr7, 0, 0, 0, 0, implicit $exec
    BUFFER_STORE_DWORD_OFFEN $vgpr4, $vgpr0, $sgpr4_sgpr5_sgpr6_sgpr7, 0, 4, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.1, implicit undef $scc

  bb.2:
    S_ENDPGM 0
...
